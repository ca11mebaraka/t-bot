# Токен T-Инвестиций (получить в приложении: Профиль → Настройки → Токены API)
INVEST_TOKEN=your_token_here

# Режим работы: sandbox (тест) или production (боевой)
TRADING_MODE=sandbox

# ID счёта (опционально — если не задан, берётся первый счёт)
ACCOUNT_ID=

# ──────────────────────────────────────────────
#  УПРАВЛЕНИЕ РИСКАМИ
# ──────────────────────────────────────────────

# Максимальный допустимый убыток за торговый день (в валюте счёта, включая комиссии).
# При достижении лимита торговля немедленно останавливается до следующего дня.
# Для команды `auto` — обязательный параметр.
# Пример: 1000 = не терять больше 1000 ₽ в день
MAX_DAILY_LOSS=1000

# Задержка перед перезапуском после ошибки в режиме `auto` (секунды)
AUTO_RESTART_DELAY=30

# Интервал вывода статуса риск-менеджера в лог (секунды, 0 = выключено)
STATUS_INTERVAL=300

# Сколько дней операций брать для восстановления FIFO-базиса риск-менеджера
RISK_HISTORY_DAYS=365

# ──────────────────────────────────────────────
#  ТОРГОВЫЕ ПАРАМЕТРЫ
# ──────────────────────────────────────────────

# Список инструментов для торговли (FIGI через запятую)
# BBG004730ZJ9  = SBER  (Сбербанк)
# BBG004730N88  = GAZP  (Газпром)
# BBG004S68473  = ROSN  (Роснефть)
# BBG006L8G4H1  = YNDX  (Яндекс)
INSTRUMENTS=BBG004730ZJ9,BBG004730N88

# Максимальный размер заявки в лотах
MAX_LOTS=1

# Интервал проверки сигналов в секундах (не менее 20 — ограничение API)
CHECK_INTERVAL=60

# ──────────────────────────────────────────────
#  LLM УПРАВЛЕНИЕ ТОРГОВЛЕЙ
# ──────────────────────────────────────────────

# true = модель выбирает инструменты и решения BUY/SELL/HOLD
LLM_ENABLED=false

# Провайдер: openai, deepseek, qwen, gigachat, anthropic, openrouter
LLM_PROVIDER=openai

# Модель провайдера, например:
# openai: gpt-4o-mini
# deepseek: deepseek-chat
# qwen: qwen-plus
# anthropic: claude-3-5-sonnet-latest
# openrouter: openai/gpt-4o-mini
LLM_MODEL=

# Универсальный ключ или provider-specific переменные ниже
LLM_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GIGACHAT_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Переопределение base URL, если нужно
LLM_BASE_URL=

# Ограничения LLM-режима
LLM_TIMEOUT=30
LLM_DECISION_INTERVAL=300
LLM_UNIVERSE_LIMIT=40
LLM_MAX_TICKERS=20
LLM_MAX_LOTS=1
LLM_SESSION_ID=t-bot-trading
LLM_SHOW_PROMPTS=true

# Для тестов без внешнего API: JSON-ответ модели
LLM_MOCK_RESPONSE=

# ──────────────────────────────────────────────
#  ОПЕРАТИВНАЯ АГРЕССИВНОСТЬ ТОРГОВЛИ
# ──────────────────────────────────────────────

# 1=очень осторожно, 3=нормально, 5=максимально агрессивно
AGGRESSION_LEVEL=3

# Минимальный интервал опроса биржи/LLM после поправки на агрессивность
AGGRESSION_MIN_INTERVAL=20

# Файл для изменения агрессивности во время сессии: {"aggression": 4}
AGGRESSION_CONTROL_FILE=.trading_control.json

# ──────────────────────────────────────────────
#  ПАРАМЕТРЫ СТРАТЕГИИ MA CROSSOVER
# ──────────────────────────────────────────────
MA_SHORT=9
MA_LONG=21

# ──────────────────────────────────────────────
#  ПАРАМЕТРЫ СТРАТЕГИИ RSI
# ──────────────────────────────────────────────
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# ──────────────────────────────────────────────
#  ПРОЧЕЕ
# ──────────────────────────────────────────────

# Директория для сохранения CSV-отчётов
REPORTS_DIR=reports
